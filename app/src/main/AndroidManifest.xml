<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SIM display name, carrier and network type. The active data sub id itself needs no permission. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Network callbacks that wake us when the cellular data network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi tile: whether Wi-Fi is on, plus generation, security and link speed. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only so Android reveals the Wi-Fi network name (SSID). Asked for from the Wi-Fi tile, never on open. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Re-register the network callback after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        All optional, so Play offers the app to every device. READ_PHONE_STATE, ACCESS_WIFI_STATE and
        the location permissions would otherwise imply these as required. Without telephony the app
        shows no SIM tiles and the widget says "No mobile network"; without Wi-Fi the Wi-Fi tile is
        hidden (see DeviceFeatures).
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
        No backups at all. Everything the app keeps describes this phone (SIM ids, signal, the
        switch log, connection history), so it would be wrong, or private, anywhere else.
        allowBackup="false" stops cloud backup; from Android 12 device-to-device transfer ignores
        it, so data_extraction_rules.xml excludes everything from both.
    -->
    <application
        android:name=".CarrierPigeonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarrierPigeon">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".ui.MainActivity" />

        <receiver
            android:name=".data.NetworkChangeReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.SimEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telephony.action.CARRIER_CONFIG_CHANGED" />
                <action android:name="android.intent.action.ACTION_DEFAULT_DATA_SUBSCRIPTION_CHANGED" />
                <action android:name="android.telephony.action.DEFAULT_SUBSCRIPTION_CHANGED" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Redraw the widget in the new language. -->
        <receiver
            android:name=".widget.LocaleChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.CarrierPigeonWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carrier_pigeon_widget_info" />
        </receiver>
    </application>
</manifest>
