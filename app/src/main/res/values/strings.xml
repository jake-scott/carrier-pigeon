<?xml version="1.0" encoding="utf-8"?>
<!--
  English (en-US) is the source language. Every string has a comment saying where it appears
  and what its placeholders hold. <annotation term="…"> marks words a person can tap to see what
  they mean; keep the tag around the matching words in your translation. Technical names such
  as LTE, 5G, NR, Wi-Fi, WPA2 and VPN stay as they are, to match the phone's status bar.
-->
<resources>
    <!-- Launcher label. A brand name: the same in every language. -->
    <string name="app_name" translatable="false">Carrier Pigeon</string>
    <!-- Name of the home-screen widget in the widget picker. -->
    <string name="widget_name">Data SIM</string>
    <!-- Description of the widget in the widget picker. -->
    <string name="widget_description">Shows which SIM is carrying mobile data right now</string>

    <!-- Top bar title. A brand name. -->
    <string name="home_title" translatable="false">Carrier Pigeon</string>
    <!-- Accessibility label for the menu button at the top right. -->
    <string name="menu_open">Menu</string>
    <!-- Menu item: read the SIM and network state again. -->
    <string name="menu_refresh">Refresh</string>
    <!-- Menu item: show the log of data SIM switches. -->
    <string name="menu_switch_log">Switch log</string>
    <!-- Menu item: share the switch log as text. -->
    <string name="menu_share_log">Share log</string>
    <!-- Menu item: delete the switch log. -->
    <string name="menu_clear_log">Clear log</string>
    <!-- Menu item (Android 13+): opens the system screen to pick this app's language. -->
    <string name="menu_language">Language</string>

    <!-- Heading above the SIM tiles. -->
    <string name="home_active_sims">Active SIMs</string>
    <!-- Hint under "Active SIMs". LTE and 5G are technical names; keep them. -->
    <string name="home_terms_hint">Tap a term like LTE or 5G to see what it means</string>
    <!-- Shown instead of SIM tiles when the phone has no active SIM. -->
    <string name="home_no_sims">No active SIMs</string>
    <!-- Shown instead of SIM tiles on a device that can't hold a SIM, e.g. a Wi-Fi-only tablet. -->
    <string name="home_no_telephony">This device can\'t use a SIM, so there are no SIMs to show</string>
    <!-- Warning above the tiles when no SIM is set for mobile data. -->
    <string name="home_no_data_sim">No SIM is carrying mobile data</string>
    <!-- Switch at the bottom of the screen: also show what is underneath the network badge, link speeds etc. -->
    <string name="home_show_detail">Show network detail</string>

    <!-- Confirmation dialog title before deleting the switch log. -->
    <string name="clear_log_title">Clear the switch log?</string>
    <!-- Confirmation dialog text before deleting the switch log. -->
    <string name="clear_log_body">This deletes the record of SIM switches kept on this phone.</string>
    <!-- Dialog title: the switch log. -->
    <string name="log_title">Switch log</string>
    <!-- Shown in the switch log dialog when the log is empty. -->
    <string name="log_empty">Nothing logged yet.</string>
    <!-- Subject line when sharing the switch log, e.g. by email. "Carrier Pigeon" is the app name. -->
    <string name="log_share_subject">Carrier Pigeon switch log</string>
    <!-- Title of the system share sheet for the switch log. -->
    <string name="log_share_chooser">Share log</string>

    <!-- Buttons. -->
    <string name="action_clear">Clear</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_close">Close</string>
    <string name="action_share">Share</string>
    <string name="action_allow">Allow</string>
    <string name="action_continue">Continue</string>
    <string name="action_not_now">Not now</string>
    <!-- Closes the popup that explains a term. -->
    <string name="action_got_it">Got it</string>

    <!-- Card shown when the app may not read phone state (the READ_PHONE_STATE permission). -->
    <string name="phone_card_body">Allow phone access to see all your SIMs, their names and network type. Without it the app and widget can only show the carrier name stored on the data SIM.</string>
    <!-- Small print on the phone access card. "Carrier Pigeon" is the app name. -->
    <string name="phone_card_note">Carrier Pigeon only reads SIM and network info. It never makes or manages calls.</string>
    <!-- Dialog before the system permission prompt for phone access. -->
    <string name="phone_rationale_title">Why phone access?</string>
    <string name="phone_rationale_body">Carrier Pigeon needs it to read your SIM names and which network each SIM is on (4G, 5G and so on), so the widget can show them.</string>
    <!-- "make and manage phone calls" quotes Android's own permission prompt; use the wording Android uses in your language. -->
    <string name="phone_rationale_calls">Android groups this with calls, so its prompt will say \"make and manage phone calls\". Carrier Pigeon never makes, answers or manages calls, and it doesn\'t read your call log or contacts.</string>
    <!-- Dialog before the system permission prompt for location, which is only used to read the Wi-Fi name. -->
    <string name="location_rationale_title">Why location access?</string>
    <string name="location_rationale_body">Android treats the name of your Wi-Fi network as location information, so it only tells apps with location access which network you\'re on.</string>
    <!-- "Precise" is the option on Android's location prompt; use the wording Android uses in your language. -->
    <string name="location_rationale_precise">Carrier Pigeon uses it only to show the Wi-Fi name. It never tracks, stores or shares where you are. Choose \"Precise\": Android hides the name from apps with only approximate location.</string>

    <!-- Large headline at the top of the screen: how the phone reaches the internet. -->
    <string name="headline_no_internet">No internet</string>
    <!-- Under "No internet", and the accessibility label of the airplane icon. -->
    <string name="airplane_mode_on">Airplane mode is on</string>
    <string name="headline_via_wifi">Internet via <annotation term="wifi">Wi-Fi</annotation></string>
    <!-- "Cellular" is mobile data from a SIM; tapping it explains the word. -->
    <string name="headline_via_cellular">Internet via <annotation term="cellular">Cellular</annotation></string>
    <string name="headline_via_ethernet">Internet via Ethernet</string>
    <string name="headline_via_bluetooth">Internet via Bluetooth</string>
    <string name="headline_via_usb">Internet via USB</string>
    <!-- Connected through something other than Wi-Fi, mobile data, Ethernet, Bluetooth or USB. -->
    <string name="headline_connected">Internet connected</string>
    <!-- Under "Internet via Cellular": SIM name · network, e.g. "Vodafone · 5G NSA". -->
    <string name="headline_cellular_subtitle" translatable="false">%1$s · %2$s</string>
    <!-- Adds a VPN to any connection, e.g. "Internet via Wi-Fi + VPN". -->
    <string name="with_vpn" translatable="false">%1$s + <annotation term="vpn">VPN</annotation></string>

    <!-- How the data SIM's tile and the widget describe the connection. Cellular with an unknown network type. -->
    <string name="access_mobile_data">Mobile data</string>
    <!-- Connected through something other than Wi-Fi, mobile data, Ethernet, Bluetooth or USB. -->
    <string name="access_connected">Connected</string>
    <!-- No internet connection at all. -->
    <string name="access_none">No data</string>
    <string name="access_wifi" translatable="false">Wi-Fi</string>
    <string name="access_ethernet" translatable="false">Ethernet</string>
    <string name="access_bluetooth" translatable="false">Bluetooth</string>
    <string name="access_usb" translatable="false">USB</string>

    <!-- Why the data SIM can't carry data. Used in "%1$s: no mobile data right now". -->
    <string name="status_airplane_mode">Airplane mode</string>
    <string name="status_data_off">Mobile data off</string>
    <string name="status_no_service">No service</string>

    <!-- SIM tile, top left: the SIM slot, e.g. "SIM 1". %1$d is the slot number. -->
    <string name="sim_slot">SIM %1$d</string>
    <!-- SIM tile, top left, when the slot is unknown. -->
    <string name="sim_generic">SIM</string>
    <!-- Name for a SIM known only by its subscription number, e.g. "SIM #3". -->
    <string name="sim_sub_id">SIM #%1$d</string>
    <!-- Widget top line when no SIM is set for mobile data. -->
    <string name="sim_no_data_sim">No data SIM</string>
    <!-- Tag on the tile of the SIM carrying the internet right now. -->
    <string name="sim_tag_mobile_data">Mobile data</string>
    <!-- Tag on the data SIM's tile when Wi-Fi is carrying the internet, so the SIM would take over if Wi-Fi went away. -->
    <string name="sim_tag_standby">Standby</string>
    <!-- SIM tile, instead of the network badge, when the SIM has no network. -->
    <string name="sim_no_network">No network</string>
    <!-- SIM tile: why there is no mobile data. %1$s is e.g. "Airplane mode" or "No service". -->
    <string name="sim_problem">%1$s: no mobile data right now</string>
    <!-- SIM tile: how the phone reaches the internet. %1$s is e.g. "Wi-Fi + VPN" or "5G NSA". -->
    <string name="sim_internet_via">Internet via: %1$s</string>
    <!-- SIM tile: this is the SIM chosen for mobile data in Settings. -->
    <string name="sim_default_data">Your default data SIM</string>
    <!-- SIM tile: the phone moved mobile data to this SIM for now (e.g. during a call or for better coverage). -->
    <string name="sim_backup_data">Backup SIM: data moved here from your default SIM</string>
    <!-- SIM tile: the SIM chosen for mobile data in Settings, while data is temporarily on the other SIM. -->
    <string name="sim_default_data_elsewhere">Your default data SIM (data is on the other SIM for now)</string>
    <!-- SIM tile detail: Android's internal subscription number. -->
    <string name="sim_subscription">Subscription %1$d</string>

    <!-- Wi-Fi tile, top left. -->
    <string name="wifi_title" translatable="false">Wi-Fi</string>
    <!-- Tag on the Wi-Fi tile when Wi-Fi is carrying the internet. -->
    <string name="wifi_tag_internet">Internet</string>
    <string name="wifi_off_airplane">No Wi-Fi: off in airplane mode</string>
    <string name="wifi_off">No Wi-Fi: Wi-Fi is off</string>
    <string name="wifi_disconnected">No Wi-Fi connection</string>
    <!-- Shown instead of the Wi-Fi network name when Android hides it. -->
    <string name="wifi_name_hidden">Network name hidden</string>
    <string name="wifi_name_needs_location">Android only shows the name to apps with location access.</string>
    <!-- "Location" is the quick settings tile of that name; use Android's wording in your language. -->
    <string name="wifi_name_location_off">Turn on Location in quick settings to see the network name.</string>
    <!-- Wi-Fi security. %1$s is e.g. "WPA2". -->
    <string name="wifi_security">Security: %1$s</string>
    <!-- Wi-Fi link speeds in megabits per second. Mbps is a unit symbol. -->
    <string name="wifi_link_speed_both">Link speed: %1$d Mbps down, %2$d Mbps up</string>
    <string name="wifi_link_speed_down">Link speed: %1$d Mbps down</string>
    <string name="wifi_link_speed_up">Link speed: %1$d Mbps up</string>
    <!-- Fastest speed the connection supports. -->
    <string name="wifi_max_speed">Max %1$d Mbps</string>
    <!-- Wi-Fi band. %1$s is a number already formatted for your language, e.g. "2.4". -->
    <string name="wifi_band">%1$s GHz</string>

    <!-- Signal strength bars on the SIM and Wi-Fi tiles, read out by screen readers. %1$d is how many bars are filled, %2$d the total, e.g. "3 of 4". -->
    <string name="signal_bars">Signal strength: %1$d of %2$d bars</string>
    <!-- The same, when the phone hasn't reported the signal strength. -->
    <string name="signal_unknown">Signal strength unknown</string>
    <!-- Signal strength detail on the SIM and Wi-Fi tiles. dBm is a unit symbol; %1$d is negative, e.g. -55. -->
    <string name="signal_dbm">Signal %1$d dBm</string>

    <!-- Widget, before anything has been read. -->
    <string name="widget_tap_to_load">Tap to load</string>
    <!-- Widget bottom line without phone access. -->
    <string name="widget_tap_to_allow">Tap to allow phone access</string>
    <!-- The same, on a narrow widget. Keep it very short. -->
    <string name="widget_tap_to_allow_short">Tap to allow</string>
    <!-- Widget top line when the data SIM has no cellular connection (airplane mode, no service). -->
    <string name="widget_no_cellular">No cellular</string>
    <!-- Widget top line on a device that can't hold a SIM, e.g. a Wi-Fi-only tablet. Keep it short. -->
    <string name="widget_no_telephony">No SIM support</string>
    <!-- Widget marker after the carrier name: data is on the SIM chosen in Settings. Lowercase, very short. -->
    <string name="widget_marker_default">default</string>
    <!-- Widget marker after the carrier name: the phone moved data to the other SIM. Lowercase, very short. -->
    <string name="widget_marker_backup">backup</string>

    <!-- History page. -->
    <!-- Menu item: open the History page (graphs of past connections, VPN and signal). -->
    <string name="menu_history">History</string>
    <!-- Title of the History page. -->
    <string name="history_title">History</string>
    <!-- Accessibility label for the back arrow on the History page. -->
    <string name="history_back">Back</string>
    <!-- Accessibility label for the History page's options button. -->
    <string name="history_menu_more">More options</string>
    <!-- History page menu item with a switch: whether the app records history. -->
    <string name="history_menu_record">Record history</string>
    <!-- History page menu item: choose how long history is kept. -->
    <string name="history_menu_keep">Keep history for…</string>
    <!-- History page menu item: delete all history. -->
    <string name="history_menu_clear">Clear history</string>
    <!-- Range button on the History page: one day. -->
    <string name="history_range_day">Day</string>
    <!-- Range button on the History page: seven days. -->
    <string name="history_range_week">Week</string>
    <!-- Range button on the History page: one calendar month. -->
    <string name="history_range_month">Month</string>
    <!-- Range button on the History page: twelve months. -->
    <string name="history_range_year">Year</string>
    <!-- Accessibility label: show the period before this one. -->
    <string name="history_previous">Earlier</string>
    <!-- Accessibility label: show the period after this one. -->
    <string name="history_next">Later</string>
    <!-- Range label on the History page for the current window: the last 24 hours up to now. -->
    <string name="history_last_day">Last 24 hours</string>
    <!-- Range label on the History page for the current window: the last 7 days up to now. -->
    <string name="history_last_week">Last 7 days</string>
    <!-- Range label on the History page for the current window: the last 30 days up to now. -->
    <string name="history_last_month">Last 30 days</string>
    <!-- Range label on the History page for the current window: the last 12 months (365 days) up to now. -->
    <string name="history_last_year">Last 12 months</string>
    <!-- Card title: what carried the internet over time (Wi-Fi, a SIM…). -->
    <string name="history_internet_via">Internet via</string>
    <!-- Card title: when a VPN was on. VPN is a technical name. -->
    <string name="history_vpn">VPN</string>
    <!-- Beside the VPN card title. %1$s is a percentage, e.g. "62%". -->
    <string name="history_vpn_share">On %1$s of the recorded time</string>
    <!-- Card title: signal strength over time. -->
    <string name="history_signal">Signal</string>
    <!-- Beside the Signal card title: the chart's scale, in status-bar bars. -->
    <string name="history_signal_hint">Bars, 0 to 4</string>
    <!-- Card title: share of time on each network type (5G NSA, LTE…) per SIM. -->
    <string name="history_network">Network type</string>
    <!-- In the History legend and readout: no internet connection. -->
    <string name="history_no_internet">No internet</string>
    <!-- In the History legend: a connection other than Wi-Fi, mobile data or Ethernet (Bluetooth, USB…). -->
    <string name="history_access_other">Other</string>
    <!-- In the History readout: nothing was recorded at that moment. -->
    <string name="history_unknown">Not recorded</string>
    <!-- A legend entry: %1$s is a name ("Wi-Fi", a SIM, "5G NSA"), %2$s an amount ("3 h 20 min", "71%"). -->
    <string name="history_total">%1$s %2$s</string>
    <!-- Accessibility description of a chart: %1$s is the card title, %2$s a summary of it. -->
    <string name="history_desc">%1$s: %2$s</string>
    <!-- In the History readout: %1$s is a SIM name or "Wi-Fi", %2$s the signal in bars (may have a decimal). -->
    <string name="history_signal_value">%1$s %2$s/4</string>
    <!-- In the History readout: a VPN was on. -->
    <string name="history_readout_vpn_on">VPN on</string>
    <!-- In the History readout: no VPN. -->
    <string name="history_readout_vpn_off">VPN off</string>
    <!-- Under the charts before anything is picked. -->
    <string name="history_readout_hint">Touch or drag across a chart to see that moment</string>
    <!-- In the Signal card when there are no readings for the period. -->
    <string name="history_nothing_recorded">Nothing recorded in this period.</string>
    <!-- Small print at the bottom of the History page. -->
    <string name="history_gaps_note">Pale stretches are times when Android didn\'t let the app run, or before history started.</string>
    <!-- Note at the top of the History page. %1$s is a date and time. -->
    <string name="history_started">Recording started %1$s</string>
    <!-- Shown on the History page before anything has been recorded. -->
    <string name="history_empty">No history yet. It builds up from now on as your connection changes.</string>
    <!-- Shown on the History page when recording is switched off. -->
    <string name="history_off">History is off. Turn on Record history in the menu to start.</string>
    <!-- Dialog title: how long to keep history. -->
    <string name="history_keep_title">Keep history for</string>
    <!-- Choice in the Keep history dialog. -->
    <string name="history_keep_1_month">1 month</string>
    <!-- Choice in the Keep history dialog. -->
    <string name="history_keep_3_months">3 months</string>
    <!-- Choice in the Keep history dialog. -->
    <string name="history_keep_1_year">1 year</string>
    <!-- Confirmation dialog title before deleting history. -->
    <string name="history_clear_title">Clear history?</string>
    <!-- Confirmation dialog text before deleting history. -->
    <string name="history_clear_body">This deletes all connection, VPN and signal history kept on this phone.</string>
    <!-- A length of time. %1$d is minutes. -->
    <string name="history_duration_minutes">%1$d min</string>
    <!-- A length of time. %1$d is hours, %2$d minutes. -->
    <string name="history_duration_hours">%1$d h %2$d min</string>
    <!-- A length of time. %1$d is days, %2$d hours. -->
    <string name="history_duration_days">%1$d d %2$d h</string>

    <!-- About page. -->
    <!-- Menu item: open the About page (app name, version and links). -->
    <string name="menu_about">About</string>
    <!-- Title of the About page. -->
    <string name="about_title">About</string>
    <!-- Accessibility label for the back arrow on the About page. -->
    <string name="about_back">Back</string>
    <!-- Under the app name on the About page. %1$s is the version name, e.g. "0.1.0" or "0.1.0-dev.15+11a78e2". -->
    <string name="about_version">Version %1$s</string>
    <!-- Smaller line under the version. %1$d is the internal build number Android and Google Play use, e.g. "42". -->
    <string name="about_version_code">Build %1$d</string>
    <!-- Link on the About page: opens the privacy policy in the browser. -->
    <string name="about_privacy">Privacy policy</string>
    <!-- Link on the About page: opens the app's source code on GitHub. -->
    <string name="about_source">Source code</string>
    <!-- Link on the About page: opens the project's issue tracker to report a bug. -->
    <string name="about_report_problem">Report a problem</string>
    <!-- Small link at the bottom of the About page: opens the license text. Apache is a name. -->
    <string name="about_license">Open source under the Apache License 2.0</string>
</resources>
